<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gerenciar Categorias"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:textColor="#2196F3"/>

    <EditText
        android:id="@+id/edtNomeCategoria"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:hint="Nome da categoria"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clique em uma categoria para selecionar"
        android:textSize="12sp"
        android:layout_marginTop="10dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="15dp">

        <LinearLayout
            android:id="@+id/layoutCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <Button
        android:id="@+id/btnSalvarCategoria"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Salvar"
        android:background="@drawable/botao"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnAtualizar"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Atualizar"
        android:background="@drawable/botao"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnExcluir"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Excluir"
        android:background="@drawable/botao"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Voltar"
        android:background="@drawable/botao"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:layout_marginBottom="10dp"/>

</LinearLayout>