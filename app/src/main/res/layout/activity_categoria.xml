<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gerenciar Categorias"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:textColor="#2196F3"/>

    <EditText
        android:id="@+id/edtNomeCategoria"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:hint="Nome da categoria"/>

    <EditText
        android:id="@+id/edtIdExcluir"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:hint="ID para excluir"
        android:inputType="number"
        android:layout_marginTop="10dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        android:background="#F8F9FA">

        <TextView
            android:id="@+id/txtCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categorias cadastradas:"
            android:textSize="16sp"
            android:padding="8dp"/>
    </ScrollView>

    <android.widget.Button
        android:id="@+id/btnSalvarCategoria"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Salvar Categoria"
        android:background="@drawable/botao"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp"/>

    <android.widget.Button
        android:id="@+id/btnExcluir"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Excluir"
        android:background="@drawable/botao"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:layout_marginBottom="8dp"/>

    <android.widget.Button
        android:id="@+id/btnVoltar"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Voltar"
        android:background="@drawable/botao"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:layout_marginBottom="10dp"/>

</LinearLayout>