<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginBottom="15dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Controle Financeiro"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gerencie gastos e receitas"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#9E9E9E"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Movimentações"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="10dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/layoutGastos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="12dp">

        <Button
            android:id="@+id/btnUsuario"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="Gerenciar Usuários"
            android:background="@drawable/botao"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnCategoria"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="Gerenciar Categorias"
            android:background="@drawable/botao"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnFormaPagamento"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="Formas de Pagamento"
            android:background="@drawable/botao"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnReceita"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="Registrar Receita"
            android:background="@drawable/botao"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnGasto"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="Registrar Gasto"
            android:background="@drawable/botao"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"/>

    </LinearLayout>

</LinearLayout>