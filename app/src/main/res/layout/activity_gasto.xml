<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar Novo Gasto"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="Selecione o Usuário"
            android:textSize="12sp"
            android:textColor="#B0B0B0"/>

        <Spinner
            android:id="@+id/spUsuario"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:backgroundTint="#66BB6A"/>

        <TextView
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="Selecione a Categoria"
            android:textSize="12sp"
            android:textColor="#B0B0B0"/>

        <Spinner
            android:id="@+id/spCategoria"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:backgroundTint="#66BB6A"/>

        <TextView
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="Forma de Pagamento"
            android:textSize="12sp"
            android:textColor="#B0B0B0"/>

        <Spinner
            android:id="@+id/spFormaPagamento"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:backgroundTint="#66BB6A"/>

        <EditText
            android:id="@+id/edtValor"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:hint="Valor (R$)"
            android:textColorHint="#9E9E9E"
            android:textColor="#FFFFFF"
            android:inputType="numberDecimal"
            android:backgroundTint="#66BB6A"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/edtDescricao"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:hint="Descrição"
            android:textColorHint="#9E9E9E"
            android:textColor="#FFFFFF"
            android:backgroundTint="#66BB6A"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnSalvarGasto"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="Salvar Gasto"
            android:background="@drawable/botao"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:background="@drawable/botao"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>